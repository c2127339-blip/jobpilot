{
  "name": "jobpilot",
  "version": "0.2.0",
  "description": "Tailor your resume and ace the interview — 根据岗位 JD 自动生成匹配简历 + 模拟面试问题",
  "type": "module",
  "bin": {
    "jp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "demo": "tsx src/index.ts questions --demo",
    "demo:resume": "tsx src/index.ts resume --demo",
    "demo:build": "node dist/index.js questions --demo"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "interview",
    "cli",
    "resume",
    "job-description",
    "ai",
    "deepseek",
    "openai",
    "interview-questions",
    "resume-generator",
    "career"
  ],
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.28",
    "ai": "^7.0.50",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/commander": "^2.12.0",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
